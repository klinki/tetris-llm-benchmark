{
  "name": "tetrisjs",
  "version": "1.0.0",
  "private": true,
  "description": "A dependency-free browser Tetris game written in TypeScript.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
