{
  "name": "tetris",
  "version": "1.0.0",
  "private": true,
  "description": "A dependency-free browser Tetris following the Tetris Guideline",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "tsc -p tsconfig.test.json && node .test-dist/test/smoke.test.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
